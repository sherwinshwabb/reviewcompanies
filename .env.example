# Configure these at build time. Leave indexing off for all previews.
SITE_URL=
SITE_INDEXING_ENABLED=false
# Comma/space-separated canonical paths to index and list in the sitemap.
# Add paths only after editorial review, or set to "all" once every page is approved.
SITE_APPROVED_PATHS=
# A real, monitored public mailbox. Enables email-app links on contact forms.
SITE_CONTACT_EMAIL=
